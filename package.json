{
  "name": "herofolio",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "scripts": {
    "start": "concurrently -k -n web,api -c magenta,cyan \"npm:start:web\" \"npm:start:server\"",
    "start:web": "vite --host",
    "start:server": "PORT=4002 tsx watch server/server.ts",
    "migrate": "tsx server/db/migrate.ts",
    "migrate:rollback": "tsx server/db/migrate.ts rollback",
    "seed": "tsx server/seed/seed.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p server",
    "test": "vitest run",
    "mobile-url": "ifconfig | grep 192.168 | awk '{print \"http://\"$2\":3000\"}'",
    "build": "vite build",
    "serve": "vite preview",
    "serve:build": "node scripts/serve-build.cjs"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "dependencies": {
    "@formkit/auto-animate": "^0.8.1",
    "@headlessui/react": "^1.7.18",
    "@tailwindcss/vite": "^4.1.11",
    "@tanstack/react-query": "^5.104.0",
    "@types/react": "18.2.45",
    "@types/react-dom": "18.2.18",
    "bcryptjs": "^3.0.3",
    "compression": "^1.8.2",
    "connect-pg-simple": "^10.0.0",
    "dotenv": "^18.0.5",
    "express": "^5.2.1",
    "express-session": "^1.19.0",
    "helmet": "^8.3.0",
    "jotai": "^3.0.1",
    "knex": "^3.3.0",
    "pg": "^8.23.1",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "react-router": "^7.7.1",
    "tsx": "^4.23.15"
  },
  "devDependencies": {
    "@trivago/prettier-plugin-sort-imports": "^5.2.2",
    "@types/compression": "^1.8.1",
    "@types/connect-pg-simple": "^7.0.3",
    "@types/express": "^5.0.6",
    "@types/express-session": "^1.19.0",
    "@types/node": "^26.6.3",
    "@vitejs/plugin-react": "^4.7.0",
    "concurrently": "^10.0.5",
    "json-loader": "0.5.7",
    "prettier-plugin-tailwindcss": "^0.6.14",
    "tailwindcss": "^4.1.11",
    "typescript": "~5.9",
    "vite": "^7.0.6",
    "vite-plugin-pwa": "^1.1.0",
    "vitest": "^5.0.3"
  }
}
